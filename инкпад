<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#f3edf7">
<title>InkPad</title>
<style>
:root{
  --p:#6750a4;--on-p:#fff;--pc:#eaddff;--on-pc:#21005d;
  --surface:#fef7ff;--surface-lowest:#fff;--surface-container:#f3edf7;--surface-high:#ece6f0;--surface-highest:#e6e0e9;
  --on-surface:#1d1b20;--on-surface-variant:#49454f;--outline:#79747e;--outline-variant:#cac4d0;
  --sc:#e8def8;--on-sc:#1d192b;--inverse:#322f35;--on-inverse:#f5eff7;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;margin:0}
body{
  background:var(--surface);color:var(--on-surface);
  font:400 16px/1.5 system-ui,Roboto,"Segoe UI",sans-serif;
  display:flex;flex-direction:column;height:100dvh;overscroll-behavior:none;overflow:hidden;
  padding:env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
}
button{font-family:inherit}
.icon-btn{
  width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:var(--on-surface-variant);
  display:grid;place-items:center;cursor:pointer;flex:none;
}
.icon-btn:hover{background:color-mix(in srgb,var(--on-surface) 8%,transparent)}
.icon-btn:active{background:color-mix(in srgb,var(--on-surface) 12%,transparent)}
.icon-btn:disabled{opacity:.38;cursor:default;background:transparent}
.icon-btn[aria-pressed=true]{background:var(--sc);color:var(--on-sc)}

/* ---------- Верхняя панель: всё для рисования и письма ---------- */
header{
  position:relative;z-index:3;background:var(--surface-container);border-radius:0 0 24px 24px;
  padding:6px 8px 6px;display:grid;align-items:center;gap:2px 8px;
  grid-template-columns:1fr auto;grid-template-areas:"left right" "tools tools";
}
@media (min-width:1100px){
  header{grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);grid-template-areas:"left tools right"}
}
.left{grid-area:left;display:flex;align-items:center;gap:4px;min-width:0}
.right{grid-area:right;display:flex;align-items:center;gap:0;position:relative;justify-content:flex-end}
.title{
  min-width:0;max-width:300px;padding:8px 12px;border:0;border-radius:12px;background:transparent;color:var(--on-surface);
  font-size:20px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;text-align:left;
}
.title:hover{background:color-mix(in srgb,var(--on-surface) 8%,transparent)}
.pagelbl{min-width:44px;text-align:center;font-size:14px;font-weight:500;color:var(--on-surface-variant);font-variant-numeric:tabular-nums}

.tools{grid-area:tools;display:flex;align-items:center;gap:12px;overflow-x:auto;scrollbar-width:none;padding:4px 2px;min-width:0}
.tools::-webkit-scrollbar{display:none}
.tools>*{flex:none}
@media (min-width:1100px){.tools{justify-content:center}}
.vr{width:1px;height:28px;background:var(--outline-variant)}
.seg{display:flex;border:1px solid var(--outline);border-radius:20px;overflow:hidden}
.seg button{
  height:40px;padding:0 14px;border:0;background:transparent;color:var(--on-surface);
  display:flex;gap:8px;align-items:center;justify-content:center;cursor:pointer;font-size:14px;font-weight:500;
}
.seg button svg{width:20px;height:20px}
.seg button+button{border-left:1px solid var(--outline)}
.seg button[aria-pressed=true]{background:var(--sc);color:var(--on-sc)}
@media (max-width:700px){
  .lbl,.vr{display:none}
  .seg button{padding:0 12px}
  .tools{gap:8px}
  .tools .icon-btn{width:40px;height:40px}
  .dots{gap:6px}
  input[type=range]{width:72px}
}
input[type=range]{width:96px;accent-color:var(--p)}
.dots{display:flex;gap:10px;padding:0 4px}
.dot{width:26px;height:26px;border-radius:50%;border:0;cursor:pointer;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--on-surface) 25%,transparent)}
.dot[aria-pressed=true]{outline:3px solid var(--p);outline-offset:2px}

.menu{
  position:absolute;top:100%;right:0;min-width:240px;padding:8px 0;border-radius:12px;display:none;z-index:9;
  background:var(--surface-high);box-shadow:0 2px 6px rgba(0,0,0,.25),0 8px 16px rgba(0,0,0,.15);
}
.menu.open{display:block}
.menu button{display:flex;gap:16px;align-items:center;width:100%;height:48px;padding:0 16px;border:0;background:transparent;color:var(--on-surface);font-size:15px;cursor:pointer;text-align:left}
.menu button:hover{background:color-mix(in srgb,var(--on-surface) 8%,transparent)}
.menu button svg{width:22px;height:22px;color:var(--on-surface-variant)}
.menu button[hidden]{display:none}
.paper-row{padding:8px 16px 12px;border-bottom:1px solid var(--outline-variant);margin-bottom:4px}
.paper-row small{display:block;margin-bottom:8px;color:var(--on-surface-variant);font-size:12px}
.paper-row .chips{gap:8px}

/* ---------- Холст на весь остальной экран ---------- */
main{flex:1;min-height:0;padding:8px}
.canvas-wrap{position:relative;height:100%;overflow:hidden;border-radius:28px;background:var(--surface-high);border:1px solid var(--outline-variant)}
.sel-bar{position:absolute;left:0;top:0;display:flex;gap:2px;padding:4px;border-radius:22px;background:var(--surface-container);box-shadow:0 1px 3px rgba(0,0,0,.3),0 4px 12px rgba(0,0,0,.18);z-index:2}
.sel-bar[hidden]{display:none}
.sel-bar button{height:36px;padding:0 14px;border:0;border-radius:18px;background:transparent;color:var(--on-surface);font-size:14px;font-weight:500;cursor:pointer}
.sel-bar button:hover{background:color-mix(in srgb,var(--on-surface) 10%,transparent)}
.sel-bar button.del{color:#d03b3b}
.chips.wrap{flex-wrap:wrap}
.fld{display:block;margin-top:12px;font-size:12px;color:var(--on-surface-variant)}
.fld input,.fld textarea{display:block;width:100%;margin-top:4px;padding:10px 12px;border:1px solid var(--outline);border-radius:12px;background:var(--surface-lowest);color:var(--on-surface);font:inherit;font-size:15px;box-sizing:border-box;resize:vertical}
.fld input:focus,.fld textarea:focus{outline:2px solid var(--p);outline-offset:-1px}
.two{display:flex;gap:10px}.two .fld{flex:1}
.err{margin:12px 0 0;color:#d03b3b;font-size:13px;min-height:1em}
#chartDlg{max-height:92vh;overflow:auto}
#chartDlg .chips{margin-top:4px}
#chartDlg small.lbl2{display:block;margin-top:14px;font-size:12px;color:var(--on-surface-variant)}
.add-tile{position:absolute;left:0;top:0;height:48px;border:2px dashed var(--outline);border-radius:24px;background:color-mix(in srgb,var(--surface-lowest) 70%,transparent);color:var(--on-surface-variant);font-size:15px;font-weight:500;cursor:pointer;z-index:1;display:flex;align-items:center;justify-content:center;gap:8px;touch-action:manipulation}
.add-tile[hidden]{display:none}
.add-tile:hover{background:var(--surface-lowest)}
canvas#cv{position:absolute;inset:0;width:100%;height:100%;touch-action:none;user-select:none;-webkit-user-select:none;cursor:crosshair}
.ph{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;color:var(--outline);font-size:22px;text-align:center;padding:24px}
.ph[hidden]{display:none}
.ph small{display:block;margin-top:12px;font-size:14px;line-height:1.5;opacity:.85}
.zoom{
  position:absolute;right:12px;bottom:12px;display:flex;align-items:center;gap:0;z-index:2;
  background:var(--surface-container);border-radius:24px;padding:2px;
  box-shadow:0 1px 3px rgba(0,0,0,.25),0 2px 8px rgba(0,0,0,.12);
}
.zoom .icon-btn{width:40px;height:40px}
.zlbl{min-width:52px;height:40px;border:0;border-radius:20px;background:transparent;color:var(--on-surface);font-size:13px;font-weight:500;cursor:pointer;font-variant-numeric:tabular-nums}
.zlbl:hover{background:color-mix(in srgb,var(--on-surface) 8%,transparent)}

/* ---------- Меню блокнотов ---------- */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:opacity .2s;z-index:6}
.scrim.open{opacity:1;pointer-events:auto}
.drawer{
  position:fixed;top:0;bottom:0;left:0;width:min(88vw,360px);z-index:7;display:flex;flex-direction:column;
  background:var(--surface-container);border-radius:0 28px 28px 0;transform:translateX(-105%);transition:transform .25s;
  padding:calc(16px + env(safe-area-inset-top)) 12px calc(12px + env(safe-area-inset-bottom)) calc(12px + env(safe-area-inset-left));
}
.drawer.open{transform:none}
.drawer h2{margin:4px 16px 12px;font-size:22px;font-weight:500}
.btn-new{
  height:56px;margin:0 0 12px;padding:0 20px 0 16px;border:0;border-radius:16px;background:var(--pc);color:var(--on-pc);
  display:flex;gap:12px;align-items:center;font-size:15px;font-weight:500;cursor:pointer;
}
#nbList{flex:1;overflow:auto;display:flex;flex-direction:column;gap:4px}
.nb{display:flex;align-items:center;border-radius:20px;padding-right:4px}
.nb.active{background:var(--sc)}
.nb-open{flex:1;min-width:0;display:flex;align-items:center;gap:12px;padding:8px 8px 8px 12px;border:0;background:transparent;color:var(--on-surface);cursor:pointer;text-align:left}
.nb canvas{width:56px;height:40px;border-radius:8px;background:var(--surface-lowest);flex:none;border:1px solid var(--outline-variant)}
.nb-meta{min-width:0;display:flex;flex-direction:column;line-height:1.3}
.nb-meta b{font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nb-meta small{color:var(--on-surface-variant);font-size:12px}
.drawer-foot{border-top:1px solid var(--outline-variant);padding-top:8px;margin-top:8px}
.drawer-foot button{display:flex;gap:16px;align-items:center;width:100%;height:48px;padding:0 16px;border:0;border-radius:24px;background:transparent;color:var(--on-surface);font-size:15px;cursor:pointer}
.drawer-foot button:hover{background:color-mix(in srgb,var(--on-surface) 8%,transparent)}
.drawer-foot svg{color:var(--on-surface-variant)}

.chips{display:flex;gap:6px}
.chip{
  height:32px;padding:0 12px;border-radius:8px;border:1px solid var(--outline);background:transparent;color:var(--on-surface-variant);
  font-size:13px;font-weight:500;cursor:pointer;
}
.chip[aria-pressed=true]{background:var(--sc);color:var(--on-sc);border-color:transparent}

/* ---------- Нижняя панель с распознанным текстом ---------- */
.sheet{
  position:fixed;left:50%;bottom:0;width:min(100%,640px);max-height:60dvh;z-index:5;overflow:auto;
  transform:translate(-50%,105%);transition:transform .25s;
  background:var(--surface-container);border-radius:28px 28px 0 0;
  padding:12px 16px calc(16px + env(safe-area-inset-bottom));
  box-shadow:0 -2px 12px rgba(0,0,0,.2);
}
.sheet.open{transform:translate(-50%,0)}
.sheet-head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.sheet-head h2{flex:1;margin:0;font-size:16px;font-weight:500}
#results{display:flex;flex-direction:column;gap:8px}
.hint{margin:0;color:var(--on-surface-variant);font-size:14px}
.cand{
  display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;border:0;border-radius:16px;padding:12px 16px;
  background:var(--surface-high);color:var(--on-surface);font-size:16px;cursor:pointer;
}
.cand span{flex:1;word-break:break-word;white-space:pre-wrap}
.cand svg{width:18px;height:18px;flex:none;opacity:.7;margin-top:4px}
.cand.top{background:var(--pc);color:var(--on-pc);font-size:18px;font-weight:500}

/* ---------- Настройки ---------- */
dialog{
  border:0;border-radius:28px;padding:24px;background:var(--surface-high);color:var(--on-surface);
  width:min(92vw,400px);
}
dialog::backdrop{background:rgba(0,0,0,.4)}
dialog h3{margin:0 0 16px;font-size:22px;font-weight:500}
dialog h4{margin:20px 0 8px;font-size:14px;font-weight:500;color:var(--p)}
.row{display:flex;align-items:center;gap:12px}
.row .grow{flex:1}
.row+.row{margin-top:16px}
.setting{margin-top:16px}
.setting input[type=range]{width:100%;margin:6px 0 0}
.setting b{font-variant-numeric:tabular-nums;min-width:2.5em;text-align:right;color:var(--p)}
.row small{display:block;color:var(--on-surface-variant);font-size:12px;line-height:1.3}
.switch{
  appearance:none;-webkit-appearance:none;flex:none;width:52px;height:32px;border-radius:16px;margin:0;
  border:2px solid var(--outline);background:var(--surface-highest);position:relative;cursor:pointer;transition:background .2s,border-color .2s;
}
.switch::after{
  content:"";position:absolute;top:50%;left:8px;width:16px;height:16px;border-radius:50%;
  background:var(--outline);transform:translateY(-50%);transition:left .2s,width .2s,height .2s,background .2s;
}
.switch:checked{background:var(--p);border-color:var(--p)}
.switch:checked::after{left:20px;width:24px;height:24px;background:var(--on-p)}
.swatches{display:flex;gap:12px;flex-wrap:wrap}
.sw{width:36px;height:36px;border-radius:50%;border:0;cursor:pointer}
.sw[aria-pressed=true]{outline:3px solid var(--on-surface);outline-offset:2px}
.dlg-actions{display:flex;justify-content:flex-end;margin-top:24px}
.btn-text{height:40px;padding:0 16px;border:0;border-radius:20px;background:transparent;color:var(--p);font-size:14px;font-weight:500;cursor:pointer}
.btn-text:hover{background:color-mix(in srgb,var(--p) 10%,transparent)}

.toast{
  position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;pointer-events:none;
  background:var(--inverse);color:var(--on-inverse);padding:12px 20px;border-radius:12px;font-size:14px;
  max-width:calc(100% - 32px);transition:opacity .2s,transform .2s;z-index:20;
}
.toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>

<header>
  <div class="left">
    <button class="icon-btn" id="menuBtn" aria-label="Блокноты" title="Блокноты" data-icon="menu"></button>
    <button class="title" id="title" title="Переименовать">Блокнот</button>
  </div>

  <div class="tools">
    <div class="seg">
      <button data-tool="pen" aria-pressed="true" title="Перо"><span data-icon="edit"></span><span class="lbl">Перо</span></button>
      <button data-tool="eraser" aria-pressed="false" title="Ластик"><span data-icon="eraser"></span><span class="lbl">Ластик</span></button>
      <button data-tool="lasso" aria-pressed="false" title="Лассо: выделить и передвинуть"><span data-icon="lasso"></span><span class="lbl">Лассо</span></button>
    </div>
    <input type="range" id="width" min="2" max="16" step="1" value="5" aria-label="Толщина" title="Толщина">
    <div class="dots" id="dots"></div>
    <span class="vr"></span>
    <button class="icon-btn" id="undo" aria-label="Отменить" title="Отменить" data-icon="undo"></button>
    <button class="icon-btn" id="redo" aria-label="Повторить" title="Повторить" data-icon="redo"></button>
    <span class="vr"></span>
    <button class="icon-btn" id="tRuler" aria-pressed="false" aria-label="Линейка" title="Линейка" data-icon="ruler"></button>
    <button class="icon-btn" id="tProto" aria-pressed="false" aria-label="Транспортир" title="Транспортир" data-icon="proto"></button>
  </div>

  <div class="right">
    <button class="icon-btn" id="prev" aria-label="Предыдущая страница" title="Предыдущая страница" data-icon="left"></button>
    <span class="pagelbl" id="pagelbl">1/1</span>
    <button class="icon-btn" id="next" aria-label="Следующая страница" title="Следующая страница" data-icon="right"></button>
    <button class="icon-btn" id="addPage" aria-label="Новая страница" title="Новая страница" data-icon="add"></button>
    <button class="icon-btn" id="more" aria-label="Ещё" title="Ещё" data-icon="more"></button>
    <div class="menu" id="menu">
      <div class="paper-row">
        <small>Разлиновка страницы</small>
        <div class="chips" id="papers">
          <button class="chip" data-paper="blank" aria-pressed="true">Чистый</button>
          <button class="chip" data-paper="grid" aria-pressed="false">Клетка</button>
          <button class="chip" data-paper="lines" aria-pressed="false">Линейка</button>
        </div>
      </div>
      <button id="mChart"><span data-icon="chart"></span>Диаграмма или график</button>
      <button id="mRec"><span data-icon="text"></span>Распознать текст</button>
      <button id="mRename"><span data-icon="edit"></span>Переименовать блокнот</button>
      <button id="mPng"><span data-icon="download"></span>Сохранить страницу как PNG</button>
      <button id="mClear"><span data-icon="eraser"></span>Очистить страницу</button>
      <button id="mDelPage"><span data-icon="delete"></span>Удалить страницу</button>
      <button id="mDelNb"><span data-icon="delete"></span>Удалить блокнот</button>
    </div>
  </div>
</header>

<main>
  <div class="canvas-wrap" id="wrap">
    <canvas id="cv"></canvas>
    <div class="ph" id="ph"><div>Пишите здесь пером<small>Задержите перо в конце линии или фигуры — она выровняется.<br>Заштрихуйте зигзагом — сотрётся только то, что под штриховкой.<br>Страницы идут вниз — листайте пальцем или колесом.<br>Два пальца — масштаб.</small></div></div>
    <div class="sel-bar" id="selBar" hidden><button id="selCopy">Копия</button><button id="selDel" class="del">Удалить</button></div>
    <button class="add-tile" id="addTile" hidden>+ Добавить страницу</button>
    <div class="zoom" id="zoom">
      <button class="icon-btn" id="zOut" aria-label="Уменьшить" title="Уменьшить" data-icon="minus"></button>
      <button class="zlbl" id="zLbl" title="Сбросить масштаб">100%</button>
      <button class="icon-btn" id="zIn" aria-label="Увеличить" title="Увеличить" data-icon="add"></button>
    </div>
  </div>
</main>

<div class="scrim" id="scrim"></div>
<aside class="drawer" id="drawer" aria-label="Блокноты">
  <h2>Блокноты</h2>
  <button class="btn-new" id="newNb"><span data-icon="add"></span>Новый блокнот</button>
  <div id="nbList"></div>
  <div class="drawer-foot">
    <button id="openSettings"><span data-icon="settings"></span>Настройки</button>
  </div>
</aside>

<section class="sheet" id="sheet" aria-label="Распознанный текст">
  <div class="sheet-head">
    <h2>Текст</h2>
    <div class="chips" id="langs">
      <button class="chip" data-lang="ru" aria-pressed="true">RU</button>
      <button class="chip" data-lang="en" aria-pressed="false">EN</button>
      <button class="chip" data-lang="uk" aria-pressed="false">UK</button>
    </div>
    <button class="icon-btn" id="sheetClose" aria-label="Закрыть" data-icon="close"></button>
  </div>
  <div id="results"></div>
</section>

<dialog id="settings">
  <h3>Настройки</h3>
  <label class="row">
    <span class="grow">Только стилус<small>Касания пальцем игнорируются (защита от ладони)</small></span>
    <input type="checkbox" class="switch" id="stylus">
  </label>
  <label class="row">
    <span class="grow">Распознавание фигур<small>Задержите перо в конце линии, круга, треугольника или прямоугольника — фигура выровняется</small></span>
    <input type="checkbox" class="switch" id="shapes">
  </label>
  <label class="row">
    <span class="grow">Привязка фигур к клеткам<small>На листе «в клетку» ровные фигуры ложатся строго по линиям сетки</small></span>
    <input type="checkbox" class="switch" id="gridSnap">
  </label>
  <label class="row">
    <span class="grow">Стирание штриховкой<small>Заштрихуйте зигзагом часть слова или рисунка поверх него — сотрётся только то, что под штриховкой</small></span>
    <input type="checkbox" class="switch" id="scribble">
  </label>
  <div class="setting">
    <label class="row" for="smooth">
      <span class="grow">Сглаживание линии<small>Выше — линия ровнее и не дрожит, но немного отстаёт от пера</small></span>
      <b id="smv">50</b>
    </label>
    <input type="range" id="smooth" min="0" max="100" step="5" value="50">
  </div>
  <div class="setting">
    <label class="row" for="calib">
      <span class="grow">Калибровка линейки<small>Приложите настоящую линейку к экрану: если сантиметры не совпадают — подгоните ползунок</small></span>
      <b id="calv">100%</b>
    </label>
    <input type="range" id="calib" min="70" max="130" step="1" value="100">
  </div>
  <h4>Цвет темы</h4>
  <div class="swatches" id="swatches"></div>
  <div class="dlg-actions"><button class="btn-text" id="settingsClose">Готово</button></div>
</dialog>

<dialog id="chartDlg">
  <h3>Диаграмма или график</h3>
  <div class="chips wrap" id="chartTypes">
    <button class="chip" data-ct="bar" aria-pressed="true">Столбцы</button>
