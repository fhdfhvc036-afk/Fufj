// ---------- Холст ----------
const cv = $('#cv'), ctx = cv.getContext('2d');
let cssW = 0, cssH = 0;
const inkColor = () => mq.matches ? '#ececf1' : '#1b1b1f';
const colorOf = s => (s.c && s.c !== 'auto') ? s.c : inkColor();
const mid = (a, b) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });

function drawStroke(c, pts, w, color){
  const n = pts.length;
  if (!n) return;
  c.strokeStyle = color; c.fillStyle = color; c.lineCap = 'round'; c.lineJoin = 'round';
  const wd = p => w * (0.55 + Math.min(1, p) * 0.9);
  if (n === 1){ c.beginPath(); c.arc(pts[0].x, pts[0].y, wd(pts[0].p) / 2, 0, Math.PI * 2); c.fill(); return; }
  let start = pts[0];
  for (let i = 1; i < n - 1; i++){
    const end = mid(pts[i], pts[i + 1]);
    c.beginPath(); c.moveTo(start.x, start.y); c.quadraticCurveTo(pts[i].x, pts[i].y, end.x, end.y);
    c.lineWidth = wd(pts[i].p); c.stroke(); start = end;
  }
  c.beginPath(); c.moveTo(start.x, start.y); c.lineTo(pts[n - 1].x, pts[n - 1].y);
  c.lineWidth = wd(pts[n - 1].p); c.stroke();
}

// Штрих, текстовая подпись или залитый многоугольник (диаграммы)
function drawItem(c, st, color){
  if (st.txt){
    const b = st.pts;
    c.save(); c.fillStyle = color; c.font = st.fs + 'px ' + FONT; c.textBaseline = 'alphabetic';
    c.textAlign = st.al === 'l' ? 'left' : st.al === 'r' ? 'right' : 'center';
    const x = st.al === 'l' ? b[0].x : st.al === 'r' ? b[1].x : (b[0].x + b[1].x) / 2;
    c.fillText(st.txt, x, b[0].y + st.fs * 0.95);
    c.restore(); return;
  }
  if (st.fill){
    c.save(); c.beginPath(); st.pts.forEach((q, i) => i ? c.lineTo(q.x, q.y) : c.moveTo(q.x, q.y)); c.closePath();
    c.globalAlpha = 0.4; c.fillStyle = st.fill; c.fill(); c.restore();
  }
  drawStroke(c, st.pts, st.w, color);
}

// Разлиновка: клетка (шаг 28) или линейка (шаг 36 с полем слева), рисуется в координатах листа
function drawPaper(c, x0, y0, x1, y1, kind, dark, k){
  if (kind !== 'grid' && kind !== 'lines') return;
  c.save();
  c.lineWidth = 1 / k;
  const h = .5 / k;
  c.strokeStyle = dark ? 'rgba(255,255,255,.11)' : 'rgba(0,0,0,.11)';
  c.beginPath();
  if (kind === 'grid'){
    const st = 28;
    for (let i = Math.floor(x0 / st); i * st <= x1; i++){ c.moveTo(i * st + h, y0); c.lineTo(i * st + h, y1); }
    for (let i = Math.floor(y0 / st); i * st <= y1; i++){ c.moveTo(x0, i * st + h); c.lineTo(x1, i * st + h); }
  } else {
    const st = 36;
    for (let i = Math.max(2, Math.floor(y0 / st)); i * st <= y1; i++){ c.moveTo(x0, i * st + h); c.lineTo(x1, i * st + h); }
  }
  c.stroke();
  if (kind === 'lines' && x0 <= 64 && x1 >= 64){
    c.beginPath();
    c.strokeStyle = dark ? 'rgba(255,120,120,.28)' : 'rgba(220,60,60,.28)';
    c.moveTo(64 + h, y0); c.lineTo(64 + h, y1); c.stroke();
  }
  c.restore();
}

// Вид: scale — масштаб, (ox, oy) — сдвиг ленты страниц в пикселях экрана
let scale = 1, ox = 0, oy = 0, dpr = 1;
const viewTransform = (c, d) => c.setTransform(d * scale, 0, 0, d * scale, d * ox, d * oy);
const s2p = (sx, sy) => ({ x: (sx - ox) / scale, y: (sy - oy) / scale - pageTop(pi) }); // экран -> координаты текущей страницы

// ---------- Лассо: выделить штрихи и передвигать ----------
let sel = null;   // { list:Set, bb, dx, dy, page }
let lasso = null; // { mode:'draw'|'move', pts, sx, sy }
function clearSel(){ if (sel){ sel = null; $('#selBar').hidden = true; } }
function inPoly(x, y, poly){
  let c = false;
  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++){
    const a = poly[i], b = poly[j];
    if ((a.y > y) !== (b.y > y) && x < (b.x - a.x) * (y - a.y) / (b.y - a.y) + a.x) c = !c;
  }
  return c;
}
function selBox(list){
  let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
  for (const st of list){ const b = bboxOf(st.pts); x0 = Math.min(x0, b.x0); y0 = Math.min(y0, b.y0); x1 = Math.max(x1, b.x1); y1 = Math.max(y1, b.y1); }
  const pad = 8; return { x0: x0 - pad, y0: y0 - pad, x1: x1 + pad, y1: y1 + pad };
}
function setSel(list){
  if (!list.length){ clearSel(); return; }
  const set = new Set(list);
  sel = { list: set, bb: selBox(list), dx: 0, dy: 0, page: pi };
}
function lassoStart(e){
  const q = toPage(e.clientX, e.clientY), m = 10 / scale;
  if (sel && sel.page === pi && q.x >= sel.bb.x0 - m && q.x <= sel.bb.x1 + m && q.y >= sel.bb.y0 - m && q.y <= sel.bb.y1 + m){
    lasso = { mode: 'move', sx: q.x, sy: q.y }; $('#selBar').hidden = true; return;
  }
  clearSel();
  lasso = { mode: 'draw', pts: [q] };
  redraw();
}
function lassoMove(e){
  const evs = e.getCoalescedEvents ? e.getCoalescedEvents() : [];
  for (const ev of (evs.length ? evs : [e])){
    const q = toPage(ev.clientX, ev.clientY);
    if (lasso.mode === 'move'){ sel.dx = q.x - lasso.sx; sel.dy = q.y - lasso.sy; }
    else lasso.pts.push(q);
  }
  redraw();
}
function moveStrokes(set, dx, dy){
  const out = new Map();
  strokes = strokes.map(st => {
    if (!set.has(st)) return st;
    const n = { ...st, pts: st.pts.map(q => ({ ...q, x: q.x + dx, y: q.y + dy })) };
    out.set(st, n); return n;
  });
  return out;
}
function lassoEnd(){
  const l = lasso; lasso = null;
  if (!l) return;
  if (l.mode === 'move'){
    if (sel && Math.hypot(sel.dx, sel.dy) * scale > 2){
      pushHistory();
      const map = moveStrokes(sel.list, sel.dx, sel.dy);
      const dx = sel.dx, dy = sel.dy;
      sel.list = new Set(Array.from(sel.list).map(st => map.get(st)));
      sel.bb = { x0: sel.bb.x0 + dx, y0: sel.bb.y0 + dy, x1: sel.bb.x1 + dx, y1: sel.bb.y1 + dy };
      sel.dx = 0; sel.dy = 0;
      changed();
    } else if (sel){ sel.dx = 0; sel.dy = 0; }
    redraw(); return;
  }
  const poly = l.pts, bb = bboxOf(poly), picked = [];
  if (Math.max(bb.w, bb.h) * scale < 10){           // касание: выбрать ближайший штрих
    const q = poly[0], R = 14 / scale; let best = null, bd = R;
    for (const st of strokes){
      const d = strokeDist(st, q) - (st.txt || st.fill ? 0 : st.w / 2);
      if (d < bd){ bd = d; best = st; }
    }
    if (best) picked.push(best);
  } else {
    for (const st of strokes){
      if (st.txt){ const m = { x: (st.pts[0].x + st.pts[1].x) / 2, y: (st.pts[0].y + st.pts[1].y) / 2 }; if (inPoly(m.x, m.y, poly)) picked.push(st); continue; }
      const b = bbOf(st);
      if (b.x1 < bb.x0 || b.x0 > bb.x1 || b.y1 < bb.y0 || b.y0 > bb.y1) continue;
      const step = Math.max(1, Math.floor(st.pts.length / 40));
      let n = 0, tot = 0;
      for (let i = 0; i < st.pts.length; i += step){ tot++; if (inPoly(st.pts[i].x, st.pts[i].y, poly)) n++; }
      if (tot && n / tot >= 0.5) picked.push(st);
    }
  }
  setSel(picked);
  redraw();
  if (!picked.length && Math.max(bb.w, bb.h) * scale >= 10) toast('Ничего не выбрано — обведите штрихи замкнутой линией');
}
function selDelete(){
  if (!sel) return;
  pushHistory(); const set = sel.list;
  strokes = strokes.filter(st => !set.has(st)); clearSel(); changed();
}
function selCopy(){
  if (!sel) return;
  pushHistory();
  const off = 24, copies = [];
  for (const st of sel.list) copies.push({ ...st, pts: st.pts.map(q => ({ ...q, x: q.x + off, y: q.y + off })) });
  strokes = strokes.concat(copies);
  setSel(copies); changed();
}
$('#selDel').onclick = selDelete;
$('#selCopy').onclick = selCopy;
['pointerdown', 'pointerup'].forEach(t => $('#selBar').addEventListener(t, e => e.stopPropagation()));

function clampView(){
  const w = PW * scale, h = docH() * scale + TILE_H;
  if (w + 2 * SIDE <= cssW) ox = (cssW - w) / 2; else ox = Math.min(SIDE, Math.max(cssW - w - SIDE, ox));
  if (h + 2 * SIDE <= cssH) oy = SIDE; else oy = Math.min(SIDE, Math.max(cssH - h - SIDE, oy));
}
function selectPage(i){
  i = Math.max(0, Math.min(nPages() - 1, i));
  if (i === pi || !cur) return;
  clearSel(); lasso = null;
  syncOut(); pi = i; strokes = cur.pages[i].strokes;
}
function syncActivePage(){ // «текущая» — страница в центре экрана
  if (!cur || activeId !== null || current) return;
  const i = Math.floor(((cssH / 2 - oy) / scale) / (PH + GAP));
  if (Math.max(0, Math.min(nPages() - 1, i)) !== pi){ selectPage(i); updateUI(); }
}
function targetOy(i){
  return PH * scale <= cssH - 2 * SIDE ? cssH / 2 - (pageTop(i) + PH / 2) * scale : SIDE - pageTop(i) * scale;
}
function stopMotion(){ if (tween){ cancelAnimationFrame(tween); tween = 0; } }
function animateY(target){
  stopMotion();
  const from = oy, t0 = performance.now();
  const step = t => {
    const k = Math.min(1, (t - t0) / 200), e = 1 - Math.pow(1 - k, 3);
    oy = from + (target - from) * e; clampView(); syncActivePage(); redraw();
    tween = k < 1 ? requestAnimationFrame(step) : 0;
  };
  tween = requestAnimationFrame(step);
}
function scrollToPage(i, anim){
  stopMotion();
  if (anim) animateY(targetOy(i)); else { oy = targetOy(i); clampView(); redraw(); }
}
function fling(vx, vy){
  stopMotion();
  let last = performance.now();
  const step = t => {
    const dt = Math.min(32, t - last); last = t;
    const f = Math.pow(0.94, dt / 16); vx *= f; vy *= f;
    const x0 = ox, y0 = oy; ox += vx * dt; oy += vy * dt;
    clampView(); syncActivePage(); redraw();
    tween = (Math.abs(vx) > 0.03 || Math.abs(vy) > 0.03) && (ox !== x0 || oy !== y0) ? requestAnimationFrame(step) : 0;
  };
  tween = requestAnimationFrame(step);
}

function redraw(){
  ctx.setTransform(1, 0, 0, 1, 0, 0);
  ctx.clearRect(0, 0, cv.width, cv.height);
  const dark = mq.matches, paper = cur ? cur.paper : 'blank';
  if (cur){
    const h = PH + GAP;
    const a = Math.max(0, Math.floor((-oy / scale) / h)), b = Math.min(nPages() - 1, Math.floor(((cssH - oy) / scale) / h));
    for (let i = a; i <= b; i++){
      viewTransform(ctx, dpr); ctx.translate(0, pageTop(i));
      ctx.save();
      ctx.shadowColor = 'rgba(0,0,0,.22)'; ctx.shadowBlur = 8 * dpr; ctx.shadowOffsetY = 1.5 * dpr;
      ctx.fillStyle = sheetBg; ctx.fillRect(0, 0, PW, PH);
      ctx.shadowColor = 'transparent';
      ctx.beginPath(); ctx.rect(0, 0, PW, PH); ctx.clip();
      const top = pageTop(i);
      drawPaper(ctx, Math.max(0, -ox / scale), Math.max(0, -oy / scale - top), Math.min(PW, (cssW - ox) / scale), Math.min(PH, (cssH - oy) / scale - top), paper, dark, scale);
      (i === pi ? strokes : cur.pages[i].strokes).forEach(s => {
        if (sel && i === pi && sel.list.has(s)){ ctx.save(); ctx.translate(sel.dx, sel.dy); drawItem(ctx, s, colorOf(s)); ctx.restore(); }
        else drawItem(ctx, s, colorOf(s));
      });
      if (current && i === pi) drawStroke(ctx, current.pts, current.w, penColor === 'auto' ? inkColor() : penColor);
      ctx.restore();
      if (i === pi && (sel || (lasso && lasso.mode === 'draw'))){
        const acc = getComputedStyle(document.documentElement).getPropertyValue('--p') || '#6750a4';
        ctx.save(); ctx.strokeStyle = acc; ctx.lineWidth = 1.6 / scale; ctx.setLineDash([7 / scale, 5 / scale]); ctx.lineJoin = 'round';
        if (lasso && lasso.mode === 'draw' && lasso.pts.length > 1){
          ctx.beginPath(); lasso.pts.forEach((q, k) => k ? ctx.lineTo(q.x, q.y) : ctx.moveTo(q.x, q.y));
          ctx.globalAlpha = .9; ctx.stroke(); ctx.globalAlpha = .08; ctx.fillStyle = acc; ctx.fill();
        }
        if (sel){
          const b = sel.bb; ctx.globalAlpha = 1;
          ctx.strokeRect(b.x0 + sel.dx, b.y0 + sel.dy, b.x1 - b.x0, b.y1 - b.y0);
        }
        ctx.restore();
      }
    }
  }
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  drawTools();
  $('#ph').hidden = !!current || !cur || strokes.length > 0 || cur.pages.some(pg => pg.strokes.length > 0);
  $('#zLbl').textContent = Math.round(scale / fit * 100) + '%';
  const bar = $('#selBar');
  if (sel && !(lasso && lasso.mode === 'move')){
    const b = sel.bb, cx = ox + ((b.x0 + b.x1) / 2) * scale, ty = oy + (pageTop(sel.page) + b.y0) * scale;
    bar.hidden = false;
    const w = bar.offsetWidth || 160, y = ty - 52 < 4 ? oy + (pageTop(sel.page) + b.y1) * scale + 10 : ty - 52;
    bar.style.transform = `translate(${Math.max(4, Math.min(cssW - w - 4, cx - w / 2))}px, ${Math.max(4, Math.min(cssH - 48, y))}px)`;
  } else bar.hidden = true;
  const tile = $('#addTile');
  if (cur){
    const w = Math.max(160, Math.min(PW * scale, 320)), y = oy + docH() * scale + 14;
    tile.hidden = y > cssH || y + 48 < 0;
    tile.style.width = w + 'px';
    tile.style.transform = `translate(${ox + PW * scale / 2 - w / 2}px, ${y}px)`;
  } else tile.hidden = true;
}

function resize(){
  const r = cv.getBoundingClientRect();
  dpr = window.devicePixelRatio || 1;
  cssW = r.width; cssH = r.height;
  clampTools();
  cv.width = Math.max(1, Math.round(r.width * dpr));
  cv.height = Math.max(1, Math.round(r.height * dpr));
  const nf = Math.max(0.05, (cssW - 2 * SIDE) / PW);
  if (!sized){ sized = true; fit = nf; scale = nf; oy = cur ? targetOy(pi) : SIDE; }
  else { const wy = -oy / scale; scale = scale / fit * nf; fit = nf; oy = -wy * scale; }
  clampView(); redraw();
}
new ResizeObserver(resize).observe($('#wrap'));

// ---------- Сохранение ----------
let saveTimer = null;
function syncOut(){ if (cur) cur.pages[pi].strokes = strokes; }
async function saveNow(){
  clearTimeout(saveTimer); saveTimer = null;
  if (!cur) return;
  syncOut();
  try{ await DB.put(cur); }catch(e){ toast('Не удалось сохранить блокнот'); }
}
function changed(){
  if (cur) cur.updated = Date.now();
  syncOut(); updateUI(); redraw();
  clearTimeout(saveTimer); saveTimer = setTimeout(saveNow, 500);
}
document.addEventListener('visibilitychange', () => { if (document.hidden) saveNow(); });
window.addEventListener('pagehide', saveNow);

// ---------- Интерфейс и история ----------
function updateUI(){
  $('#title').textContent = cur ? cur.title : 'Блокнот';
  const n = cur ? cur.pages.length : 1;
  $('#pagelbl').textContent = (pi + 1) + '/' + n;
  $('#prev').disabled = pi <= 0;
  $('#next').disabled = pi >= n - 1;
  $('#undo').disabled = !undoStack.length;
  $('#redo').disabled = !redoStack.length;
  $('#mDelPage').hidden = n < 2;
  const paper = (cur && cur.paper) || 'blank';
  $$('[data-paper]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.paper === paper)));
}
$$('[data-paper]').forEach(b => b.onclick = e => {
  e.stopPropagation();
  if (!cur) return;
  cur.paper = b.dataset.paper; store.set('paper', cur.paper);
  changed();
});
function pushHistory(){ undoStack.push({ p: pi, s: strokes.slice() }); redoStack.length = 0; }
function ensureVisible(i){
  const top = oy + pageTop(i) * scale, bot = top + PH * scale;
  if (bot < 40 || top > cssH - 40) scrollToPage(i, true);
}
function stepHistory(from, to){
  if (!from.length) return;
  const e = from.pop();
  clearSel(); lasso = null;
  selectPage(e.p);
  to.push({ p: e.p, s: strokes });
  strokes = e.s; changed(); ensureVisible(e.p);
}
$('#undo').onclick = () => stepHistory(undoStack, redoStack);
$('#redo').onclick = () => stepHistory(redoStack, undoStack);

// Старые блокноты (бесконечный лист) вписываем в страницу А4
function migrate(nb){
  if (nb.v >= 2) return;
  nb.v = 2;
  for (const pg of nb.pages){
    if (!pg.strokes.length) continue;
    let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
    for (const st of pg.strokes){ const q = bboxOf(st.pts); x0 = Math.min(x0, q.x0); y0 = Math.min(y0, q.y0); x1 = Math.max(x1, q.x1); y1 = Math.max(y1, q.y1); }
    if (x0 >= 0 && y0 >= 0 && x1 <= PW && y1 <= PH) continue;
    const m = 16, k = Math.min(1, (PW - 2 * m) / Math.max(1, x1 - x0), (PH - 2 * m) / Math.max(1, y1 - y0));
    pg.strokes = pg.strokes.map(st => ({ ...st, w: st.w * k, pts: st.pts.map(q => ({ ...q, x: (q.x - x0) * k + m, y: (q.y - y0) * k + m })) }));
  }
}
function loadPage(){
  migrate(cur);
  pi = Math.max(0, Math.min(pi, cur.pages.length - 1));
  strokes = cur.pages[pi].strokes;
  undoStack = []; redoStack = []; current = null; stopMotion(); clearSel(); lasso = null;
  scale = fit; ox = 0; oy = targetOy(pi); clampView();
  closeSheet(); updateUI(); redraw();
}

// ---------- Блокноты и страницы ----------
const newId = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
async function createNotebook(){
  await saveNow();
  const nb = { id: newId(), title: 'Блокнот ' + (notebooks.length + 1), created: Date.now(), updated: Date.now(), paper: store.get('paper', 'blank'), pages: [{ strokes: [] }], v: 2 };
  notebooks.push(nb);
  cur = nb; pi = 0; store.set('last', nb.id);
  loadPage();
  try{ await DB.put(nb); }catch(e){ toast('Не удалось сохранить блокнот'); }
}
async function openNotebook(id){
  const nb = notebooks.find(x => x.id === id);
  if (!nb || nb === cur) return;
  await saveNow();
  cur = nb; pi = 0; store.set('last', id);
  loadPage();
}
async function removeNotebook(nb){
  if (!confirm('Удалить «' + nb.title + '» вместе со всеми страницами?')) return;
  try{ await DB.del(nb.id); }catch(e){}
  notebooks = notebooks.filter(x => x !== nb);
  if (nb === cur){
    cur = null;
    if (notebooks.length){
      const next = notebooks.slice().sort((a, b) => b.updated - a.updated)[0];
      cur = next; pi = 0; store.set('last', next.id); loadPage();
    } else { await createNotebook(); }
  }
  renderDrawer();
}
function goPage(n){
  if (!cur || n < 0 || n >= cur.pages.length) return;
  selectPage(n); updateUI(); scrollToPage(n, true);
}
$('#prev').onclick = () => goPage(pi - 1);
$('#next').onclick = () => goPage(pi + 1);
function addPageEnd(){
  if (!cur) return;
  syncOut(); cur.pages.push({ strokes: [] });
  selectPage(cur.pages.length - 1); changed(); scrollToPage(pi, true);
  toast('Страница ' + (pi + 1));
}
$('#addPage').onclick = addPageEnd;
$('#addTile').onclick = addPageEnd;

// ---------- Меню блокнотов (боковая панель) ----------
const fmtDate = ts => new Date(ts).toLocaleString('ru-RU', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
function drawThumb(c, list){
  const g = c.getContext('2d'); if (!g) return;
  let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
  list.forEach(s => s.pts.forEach(p => { x0 = Math.min(x0, p.x); y0 = Math.min(y0, p.y); x1 = Math.max(x1, p.x); y1 = Math.max(y1, p.y); }));
  if (x0 > x1) return;
  const W = c.width, H = c.height, pad = 8;
  const k = Math.min((W - pad * 2) / Math.max(1, x1 - x0), (H - pad * 2) / Math.max(1, y1 - y0));
  const ox = (W - (x1 - x0) * k) / 2 - x0 * k, oy = (H - (y1 - y0) * k) / 2 - y0 * k;
  g.lineWidth = 2.5; g.lineCap = 'round'; g.lineJoin = 'round';
  list.forEach(s => {
    if (s.txt) return;
    g.strokeStyle = colorOf(s); g.beginPath();
    s.pts.forEach((p, i) => i ? g.lineTo(p.x * k + ox, p.y * k + oy) : g.moveTo(p.x * k + ox, p.y * k + oy));
    if (s.pts.length === 1) g.lineTo(s.pts[0].x * k + ox + .1, s.pts[0].y * k + oy);
    g.stroke();
  });
}
function renderDrawer(){
  syncOut();
  const box = $('#nbList'); box.textContent = '';
  notebooks.slice().sort((a, b) => b.updated - a.updated).forEach(nb => {
    const row = document.createElement('div'); row.className = 'nb' + (nb === cur ? ' active' : '');
    const open = document.createElement('button'); open.className = 'nb-open';
    const th = document.createElement('canvas'); th.width = 112; th.height = 80;
    drawThumb(th, nb.pages[0].strokes);
    const meta = document.createElement('span'); meta.className = 'nb-meta';
    const t = document.createElement('b'); t.textContent = nb.title;
