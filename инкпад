const DB = (() => {
  let db = null, ok = false;
  const mem = new Map();
  const open = () => new Promise(res => {
    try{
      const rq = indexedDB.open('inkpad', 1);
      rq.onupgradeneeded = () => rq.result.createObjectStore('nb', { keyPath: 'id' });
      rq.onsuccess = () => { db = rq.result; ok = true; res(true); };
      rq.onerror = () => res(false);
      rq.onblocked = () => res(false);
    }catch(e){ res(false); }
  });
  const tx = (mode, fn) => new Promise((res, rej) => {
    const t = db.transaction('nb', mode);
    const r = fn(t.objectStore('nb'));
    t.oncomplete = () => res(r && r.result);
    t.onerror = () => rej(t.error);
    t.onabort = () => rej(t.error);
  });
  return {
    init: async () => { await open(); return ok; },
    all: async () => ok ? tx('readonly', s => s.getAll()) : Array.from(mem.values()),
    put: async nb => { if (!ok){ mem.set(nb.id, nb); return; } return tx('readwrite', s => s.put(nb)); },
    del: async id => { if (!ok){ mem.delete(id); return; } return tx('readwrite', s => s.delete(id)); },
    get ok(){ return ok; }
  };
})();

